<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD_SucKhoe.NutritionPage"
             Title="Gợi ý dinh dưỡng">

	<ScrollView>
		<VerticalStackLayout Padding="20"
                             Spacing="18">

			<!-- TIÊU ĐỀ -->
			<Label Text="Gợi ý món ăn theo BMI"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1976D2" />

			<!-- Layout động chứa phần ăn sáng/trưa/chiều/tối -->
			<VerticalStackLayout x:Name="ContentLayout"
                                 Spacing="14" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
