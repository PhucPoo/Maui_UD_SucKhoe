<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD_SucKhoe.MenuPage"
             BackgroundColor="#F8F8F8"
             Title="Menu">

	<ScrollView>
		<VerticalStackLayout Spacing="0" Padding="0">

			<!-- Header Section -->
			<Grid Padding="20,40,20,20"
                  RowDefinitions="Auto,Auto,Auto">
				<!-- Background Image -->
				<Image Grid.RowSpan="3"
                       Source="bg_menu.jpg"
                       Aspect="AspectFill"
				HeightRequest="240" />

				<!-- Overlay màu để text dễ đọc hơn -->
				<BoxView Grid.RowSpan="3"
                         Color="White"
                         Opacity="0.2"/>

				<Grid.Shadow>
					<Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
				</Grid.Shadow>

				
				
			</Grid>

			<!-- Menu Items Section -->
			<VerticalStackLayout Spacing="0" Margin="0,50,0,0">

				<!-- Quản lý thực đơn -->
				<Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="20,16"
                        Margin="12,0">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
					</Border.Shadow>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnMenuManagementTapped"/>
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#FFE5E5"
                                StrokeThickness="0"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10"/>
							</Border.StrokeShape>
							<Label Text="🍽️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Border>
						<Label Grid.Column="1"
                               Text="Quản lý thực đơn"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"/>
						<Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="#C8C8C8"
                               VerticalOptions="Center"/>
					</Grid>
				</Border>

				<!-- Quản lý tập luyện -->
				<Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="20,16"
                        Margin="12,12">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
					</Border.Shadow>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnWorkoutManagementTapped"/>
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#E5F3FF"
                                StrokeThickness="0"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10"/>
							</Border.StrokeShape>
							<Label Text="💪"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Border>
						<Label Grid.Column="1"
                               Text="Quản lý tập luyện"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"/>
						<Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="#C8C8C8"
                               VerticalOptions="Center"/>
					</Grid>
				</Border>

				<!-- Cài đặt -->
				<Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="20,16"
                        Margin="12,0">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
					</Border.Shadow>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnSettingsTapped"/>
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#F0F0F0"
                                StrokeThickness="0"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10"/>
							</Border.StrokeShape>
							<Label Text="⚙️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Border>
						<Label Grid.Column="1"
                               Text="Cài đặt"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"/>
						<Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="#C8C8C8"
                               VerticalOptions="Center"/>
					</Grid>
				</Border>

				<!-- Thông tin -->
				<Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="20,16"
                        Margin="12,12">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
					</Border.Shadow>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnAboutTapped"/>
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#E8F5E9"
                                StrokeThickness="0"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10"/>
							</Border.StrokeShape>
							<Label Text="ℹ️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Border>
						<Label Grid.Column="1"
                               Text="Thông tin"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"/>
						<Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="#C8C8C8"
                               VerticalOptions="Center"/>
					
				
					
					</Grid>
				
				</Border>
				<!-- Quay lại -->
				<Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        Padding="20,16"
                        Margin="12,12">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
					</Border.Shadow>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnCloseTapped"/>
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto">
						<Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="#E8F5E9"
                                StrokeThickness="0"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10"/>
							</Border.StrokeShape>
							<Label Text="‹"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Border>
						<Label Grid.Column="1"
                               Text="Quay lại"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"/>
						<Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="#C8C8C8"
                               VerticalOptions="Center"/>
					
				
					
					</Grid>
				
				</Border>

			</VerticalStackLayout>



		</VerticalStackLayout>
	</ScrollView>

</ContentPage>