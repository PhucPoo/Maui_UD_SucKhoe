<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD_SucKhoe.WorkoutManagementPage"
             BackgroundColor="#F8F8F8"
             Title="Quản lý tập luyện">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
		<!-- Header -->
		<Border Grid.Row="0"
				BackgroundColor="White"
				StrokeThickness="0"
				Padding="16"
				Margin="0,0,0,16">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="12"/>
			</Border.StrokeShape>
			<Border.Shadow>
				<Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.08"/>
			</Border.Shadow>

			<Grid ColumnDefinitions="Auto,*">

				<!-- Nút quay lại -->
				<Border WidthRequest="40"
						HeightRequest="40"
						BackgroundColor="#EEEEEE"
						HorizontalOptions="Start"
						VerticalOptions="Center">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="20"/>
					</Border.StrokeShape>

					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnBackTapped"/>
					</Border.GestureRecognizers>

					<Label Text="‹"
						   FontSize="30"
						   VerticalOptions="Start"
						   HorizontalOptions="Center"
						   TextColor="#333"/>
				</Border>

				<!-- Tiêu đề -->
				<Label Grid.Column="1"
					   Text="💪 Danh sách bài tập"
					   FontSize="20"
					   FontAttributes="Bold"
					   TextColor="#2196F3"
					   HorizontalOptions="Center"
					   VerticalOptions="Center"/>
			</Grid>
		</Border>


		<!-- Danh sách bài tập -->
        <CollectionView Grid.Row="1"
                        x:Name="WorkoutCollectionView"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,1" Radius="4" Opacity="0.08"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <!-- Tên bài tập -->
                            <Label Grid.Column="0" Grid.Row="0"
                                   Text="{Binding ExerciseName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black"/>

                            <!-- Thông tin chi tiết -->
                            <Label Grid.Column="0" Grid.Row="1"
                                   Text="{Binding DisplayInfo}"
                                   FontSize="13"
                                   TextColor="#666"
                                   Margin="0,6,0,0"/>

                            <!-- Nút Sửa -->
                            <Border Grid.Column="1" Grid.RowSpan="2"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#FFF3E0"
                                    StrokeThickness="0"
                                    Margin="8,0,8,0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand}" CommandParameter="{Binding}"/>
                                </Border.GestureRecognizers>
                                <Label Text="✏️"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Nút Xóa -->
                            <Border Grid.Column="2" Grid.RowSpan="2"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#FFEBEE"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DeleteCommand}" CommandParameter="{Binding}"/>
                                </Border.GestureRecognizers>
                                <Label Text="🗑️"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Nút Thêm mới -->
        <Border Grid.Row="2"
                BackgroundColor="#2196F3"
                StrokeThickness="0"
                Padding="16"
                Margin="0,16,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.2"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddCommand}"/>
            </Border.GestureRecognizers>
            <Label Text="➕ Thêm bài tập mới"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Border>

    </Grid>

</ContentPage>